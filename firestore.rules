// Max Player — Refer & Earn + admin dashboard (v1.0.1+58)
// Paste into Firebase console -> Firestore -> Rules.
//
// Model note: profiles are anonymous (install-id based, no Firebase Auth),
// so writes can't be owner-authenticated. Contents are counters and codes
// only — nothing personal — which keeps open-write abuse cosmetic.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{id} {
      allow read: if true;
      allow create, update: if true; // anonymous counters only
      allow delete: if false;
    }
    match /codes/{code} {
      allow read: if true;            // needed to claim a valid code
      allow create: if true;
      allow update, delete: if false; // codes are claimed once, forever
    }
    match /referral_board/{id} {
      allow read: if true;            // leaderboard on the admin site
      allow create, update: if true;
      allow delete: if false;
    }
    match /stats/{doc} {
      allow read: if true;            // aggregate daily counters only
      allow create, update: if true;
      allow delete: if false;
    }
  }
}
