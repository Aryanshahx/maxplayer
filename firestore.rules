rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function admin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    match /admins/{uid} {
      allow get: if owner(uid);
      allow list, write: if false; // Create admin records manually in Console.
    }
    match /notices/{noticeId} {
      allow read: if admin();
      allow create: if admin()
        && request.resource.data.keys().hasAll(['title','message','target','status','createdAt'])
        && request.resource.data.keys().hasOnly(['title','message','target','status','createdAt','imageData','link','screen','movieId','movieKind','movieTitle'])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 80
        && request.resource.data.message is string && request.resource.data.message.size() <= 900
        && request.resource.data.target is string
        && request.resource.data.target.matches('^(all|[A-Za-z0-9_-]{1,128})$')
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && (!('screen' in request.resource.data) || request.resource.data.screen in ['home','discover','private','folders','playlists','audio','network','cloud','quickShare','stream','iptv','statistics','movie','external'])
        && (!('screen' in request.resource.data) || request.resource.data.screen != 'movie' || (request.resource.data.movieId is string && request.resource.data.movieId.matches('^[1-9][0-9]{0,8}$') && request.resource.data.movieKind in ['movie','tv'] && request.resource.data.movieTitle is string && request.resource.data.movieTitle.size() > 0 && request.resource.data.movieTitle.size() <= 150))
        && (!('imageData' in request.resource.data) || (request.resource.data.imageData is string && request.resource.data.imageData.size() <= 420000 && request.resource.data.imageData.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$')))
        && (!('link' in request.resource.data) || (request.resource.data.link is string && request.resource.data.link.size() <= 2048 && (request.resource.data.link == '' || request.resource.data.link.matches('^https://.+'))));
      allow update, delete: if false; // Only Admin SDK can claim/change status.
    }
    match /themes/{themeId} {
      allow read: if admin();
      allow create, update: if admin()
        && request.resource.data.keys().hasOnly(['name','config','updatedAt'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 60
        && request.resource.data.config is map && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    match /appConfig/theme {
      allow read: if true;
      allow create, update: if admin()
        && request.resource.data.keys().hasOnly(['enabled','theme','updatedAt'])
        && request.resource.data.enabled is bool
        && (!request.resource.data.enabled || request.resource.data.theme is map)
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    match /appConfig/themeAudience {
      allow read: if true;
      allow create, update: if admin()
        && request.resource.data.keys().hasOnly(['slots','updatedAt'])
        && request.resource.data.slots is map
        && request.resource.data.slots.size() <= 260
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    match /adminJobs/{jobId} {
      allow read: if admin();
      allow create: if admin()
        && request.resource.data.keys().hasOnly(['action','status','confirmation','actor','createdAt'])
        && request.resource.data.action == 'resetAnalytics'
        && request.resource.data.status == 'pending'
        && request.resource.data.confirmation == 'RESET ANALYTICS'
        && request.resource.data.actor == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
    match /publishedNotices/{noticeId} {
      allow read: if signedIn();
      allow write: if false; // Shared all-users history; workflow publishes.
    }
    match /users/{uid}/tokens/{tokenId} {
      allow read, delete: if owner(uid);
      allow create, update: if owner(uid)
        && request.resource.data.keys().hasOnly(['token','platform','updatedAt'])
        && request.resource.data.token is string
        && request.resource.data.token.size() > 0 && request.resource.data.token.size() <= 4096
        && request.resource.data.platform == 'android'
        && request.resource.data.updatedAt == request.time;
    }
    match /users/{uid}/inbox/{noticeId} {
      allow read: if owner(uid);
      allow write: if false;
    }
    // Existing anonymous aggregate analytics retained for dashboard compatibility.
    // These are not trusted installation counts and remain vulnerable to spam.
    match /stats/{doc} {
      allow read, create, update: if true;
      allow delete: if false;
    }
    match /reports/{doc} {
      allow read: if admin();
      allow create: if true;
      allow update, delete: if false;
    }
    match /broadcasts/{doc} {
      allow read, write: if false; // Old in-app broadcast sender retired.
    }
  }
}
