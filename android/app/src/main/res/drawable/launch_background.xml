<?xml version="1.0" encoding="utf-8"?>
<!-- Modify this file to customize your launch splash screen -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@android:color/white" />

    <!-- v79: logo shown while the app is cold-starting. Kept its own
         background intact (matches the launcher icon) instead of being
         cut out onto a separate card. -->
    <item android:width="200dp" android:height="200dp" android:gravity="center">
        <bitmap android:gravity="center" android:src="@drawable/splash_logo" />
    </item>
</layer-list>
